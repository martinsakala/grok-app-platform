{
  "name": "grok-app-platform",
  "private": true,
  "type": "module",
  "description": "Canonical shared platform layer for Grok Build applications",
  "exports": {
    "./runtime": "./src/runtime/index.ts",
    "./database": "./src/database/index.ts",
    "./auth": "./src/auth/index.ts",
    "./data-api": "./src/data-api/index.ts",
    "./http": "./src/http/index.ts",
    "./logging": "./src/logging/index.ts",
    "./access": "./src/access/index.ts",
    "./api-keys": "./src/api-keys/index.ts",
    "./settings": "./src/settings/index.ts",
    "./audit": "./src/audit/index.ts",
    "./ui": "./src/ui/index.ts",
    "./design": "./src/design/index.ts",
    "./mutations": "./src/mutations/index.ts",
    "./registry": "./src/registry/index.ts"
  },
  "scripts": {
    "generate:version": "node scripts/generate-platform-version.mjs",
    "generate:migrations": "node scripts/generate-platform-migrations.mjs",
    "generate:design": "node --experimental-strip-types scripts/generate-design-tokens.mjs",
    "generate:gallery": "node --experimental-strip-types scripts/generate-design-gallery.mjs",
    "generate": "npm run generate:version && npm run generate:migrations && npm run generate:gallery",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate",
    "prebuild": "npm run generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prove:lock": "node scripts/prove-advisory-lock.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
