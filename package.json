{
  "name": "grok-app-platform",
  "private": true,
  "type": "module",
  "description": "Canonical shared platform layer for Grok Build applications",
  "exports": {
    "./runtime": "./src/runtime/index.ts",
    "./database": "./src/database/index.ts",
    "./auth": "./src/auth/index.ts",
    "./data-api": "./src/data-api/index.ts",
    "./http": "./src/http/index.ts",
    "./logging": "./src/logging/index.ts"
  },
  "scripts": {
    "generate:version": "node scripts/generate-platform-version.mjs",
    "generate:migrations": "node scripts/generate-platform-migrations.mjs",
    "generate": "npm run generate:version && npm run generate:migrations",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate",
    "prebuild": "npm run generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prove:lock": "node scripts/prove-advisory-lock.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
